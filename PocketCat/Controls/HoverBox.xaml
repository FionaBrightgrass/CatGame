<Window x:Class="PocketCat.Controls.HoverBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="300" Height="60">
    <Border x:Name="MainBorder" 
            BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
            BorderThickness="1" 
            CornerRadius="2"
            Padding="5"
            Margin="0">
        <Border.Background>
            <SolidColorBrush Color="{Binding WindowColorBrush.Color, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
                             Opacity="0.85" />
        </Border.Background>
        <TextBlock x:Name="HoverTextBlock" 
                   Foreground="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
                   FontSize="14" 
                   TextWrapping="Wrap" 
                   FontFamily="Unispace" />
    </Border>
</Window>
