<Window x:Class="PocketCat.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketCat.Controls"
        xmlns:main="clr-namespace:PocketCat" d:DataContext="{d:DesignInstance Type=main:AppSettings}"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="450" Width="300" WindowStyle="none" AllowsTransparency="True" Opacity="0.9" Background="{Binding WindowColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" MouseDown="Window_MouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UIDictionary/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="Transparent">
        <StackPanel>
            <DockPanel Height="40" Width="Auto" HorizontalAlignment="Stretch">
                <Button Style="{StaticResource SharpButtonStyle}" Click="CloseWindow">x</Button>
            </DockPanel>
            <StackPanel Margin="8,4,8,8">
                <TextBlock Foreground="White" Text="App Options" Margin="4" FontFamily="Unispace" FontSize="18"/>
                <CheckBox Foreground="White" Content="| Close to Tray" Margin="61,4,4,4" FontFamily="Unispace" FontSize="18"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020" Text="{Binding WindowColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Window Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020" Text="{Binding BorderColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Border Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020" Text="{Binding ButtonColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Button Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020" Text="{Binding TextColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Text Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <TextBlock Foreground="White" Text="" Margin="4" FontFamily="Unispace" FontSize="6"/>
                <TextBlock Foreground="White" Text="Cat Options" Margin="4" FontFamily="Unispace" FontSize="18"/>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding PrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="PrimaryColor_TextChanged"
                         Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Primary Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <!-- Secondary Color -->
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding SecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="SecondaryColor_TextChanged"
                         Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Secondary Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <!-- Tertiary Color -->
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding TertiaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TertiaryColor_TextChanged"
                         Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Tertiary Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <!-- Detail Color -->
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding DetailColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="DetailColor_TextChanged"
                         Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Detail Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>

                <!-- Eye Color -->
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding EyeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="EyeColor_TextChanged"
                         Width="70" FontFamily="Unispace" FontSize="14"/>
                    <TextBlock Foreground="White" Text="| Eye Color" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>
                <DockPanel HorizontalAlignment="Left">
                    <TextBox Margin="4" Foreground="White" Background="#202020" 
             Width="70" FontFamily="Unispace" FontSize="14">
                        <TextBox.Text>
                            <Binding Path="SleepInterval" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:IntegerValidationRule Min="1" Max="60" />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Foreground="White" Text="| Minutes Per ZzZ" Margin="4" FontFamily="Unispace" FontSize="18"/>
                </DockPanel>

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
