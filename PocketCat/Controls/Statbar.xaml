<UserControl x:Class="PocketCat.Controls.Statbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PocketCat.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="200">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="40" Margin="0">
            <!-- Bind Header Text to HeaderText DependencyProperty -->
            <TextBlock x:Name="Header" Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="Unispace" Foreground="White" Height="18" Margin="2,2,2,-4" />
            <StackPanel x:Name="StatbarPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
                <!-- Rectangles (remain unchanged) -->
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
                <Rectangle Width="8" Height="20" Fill="Black" Margin="1" Stroke="White" StrokeThickness="1" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
