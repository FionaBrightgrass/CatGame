<Window x:Class="PocketCat.Controls.CallPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketCat.Controls"
        mc:Ignorable="d"
        Title="CallWindow" Height="64" Width="400" WindowStyle="none" AllowsTransparency="True" Opacity="0.8" Background="Black">
    <Border Background="Transparent" 
            BorderBrush="Transparent" 
            BorderThickness="0" 
            CornerRadius="6">
        <Grid>
            <TextBlock Foreground="White" FontSize="14" FontFamily="Unispace" IsHitTestVisible="False" Margin="8,8,8,8" TextWrapping="Wrap">You call the cat, but she doesn't seem to recognize her name...</TextBlock>
        </Grid>
    </Border>
</Window>
