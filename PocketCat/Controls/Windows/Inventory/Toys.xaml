<Window x:Class="PocketCat.Controls.Windows.Inventory.ToyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketCat.Controls.Windows.Inventory"
        xmlns:items="clr-namespace:PocketCat.StaticGame.Items"
        xmlns:appSettings="clr-namespace:PocketCat" 
        mc:Ignorable="d"
        Title="ToyWindow" x:Name="Toys" Height="450" Width="300" WindowStyle="None" Background="Transparent" AllowsTransparency="True" MouseDown="Window_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../UIDictionary/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Row Style for Background Binding -->
            <Style x:Key="DynamicRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Cell Style for Conditional Backgrounds -->
            <Style x:Key="DynamicCellStyle" TargetType="DataGridCell">
                <Style.Triggers>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainBorder" BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
        BorderThickness="0,2,2,2" CornerRadius="0,5,5,0" Margin="0">
        <Border.Background>
            <SolidColorBrush Color="{Binding WindowColorBrush.Color, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
                         Opacity="0.85" />
        </Border.Background>
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="MainGrid">
            <StackPanel>
                <DockPanel Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <DockPanel HorizontalAlignment="Left" Margin="12,12,0,0">
                        <TextBlock Text="Items" FontFamily="Unispace" FontSize="22" Foreground="{Binding TextColorText, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <DockPanel HorizontalAlignment="Right">
                        <Button x:Name="Close_Button" Click="CloseWindow" Style="{StaticResource SharpButtonStyle}">
                            <TextBlock Text="x"></TextBlock>
                        </Button>
                    </DockPanel>
                </DockPanel>
                <DataGrid x:Name="ToysGrid"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          RowStyle="{StaticResource DynamicRowStyle}"
                          CellStyle="{StaticResource ItemDataGridCell}"
                          Background="{Binding WindowColorBrush.Color, Source={StaticResource AppSettings}}"
                          ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False"
                          RowHeight="32"
                          MouseDoubleClick="ToysGrid_MouseDoubleClick" >

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Image}" Width="20" Height="26" Focusable="False" VerticalAlignment="Top"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="Name" Header=" " Binding="{Binding Name}" Width="180" Foreground="{Binding TextColorBrush, Source={StaticResource AppSettings}}" IsReadOnly="True" CellStyle="{StaticResource ShopDataGridCell}" FontFamily="Unispace"/>
                        <DataGridTextColumn x:Name="Quantity" Header="Quantity" Binding="{Binding Quantity}" Width="80" Foreground="{Binding TextColorBrush, Source={StaticResource AppSettings}}" IsReadOnly="True" CellStyle="{StaticResource ShopDataGridCell}" FontFamily="Unispace" FontSize="12"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <Canvas x:Name="FloatingTextCanvas" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
