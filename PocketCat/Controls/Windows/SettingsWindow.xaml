<Window x:Class="PocketCat.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PocketCat.Controls"
        xmlns:main="clr-namespace:PocketCat" d:DataContext="{d:DesignInstance Type=main:AppSettings}"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="450" Width="300" WindowStyle="none" AllowsTransparency="True" Background="Transparent" MouseDown="Window_MouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UIDictionary/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Style for TabItem to mimic FullWidthButtonStyle -->
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
        BorderThickness="0,2,2,2" CornerRadius="0,5,5,0" Margin="0">
        <Border.Background>
            <SolidColorBrush Color="{Binding WindowColorBrush.Color, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
                         Opacity="0.85" />
        </Border.Background>
        <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="303">
            <StackPanel>
                <DockPanel Height="40" Width="Auto" HorizontalAlignment="Stretch">
                    <!-- "Settings" Text -->
                    <TextBlock Text="Settings"
                               Foreground="White"
                               FontFamily="Unispace"
                               FontSize="22"
                               Margin="12,12,0,0"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />

                    <!-- Close Button -->
                    <Button Style="{StaticResource SharpButtonStyle}" 
                            Content="x" 
                            Click="CloseWindow"
                            HorizontalAlignment="Right" 
                            Margin="0,0,8,0"
                            DockPanel.Dock="Right" />
                </DockPanel>
                <!-- Add TabControl with FullWidthTabItemStyle -->
                <Border BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
        BorderThickness="1,0,0,0" Margin="0,12,-3,-8">
                    <TabControl Margin="-3,-8,8,-8" Background="Transparent"
            ItemContainerStyle="{StaticResource FullWidthTabItemStyle}"
            BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"
            BorderThickness="0,1,2,2" Height="412" Width="302">
                        <!-- Window Tab -->
                        <TabItem Header="Window" Margin="-3,0,0,0" Width="100">
                            <!-- Make content fill space -->
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8">
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding WindowColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Window Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding BorderColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Border Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding ButtonColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Button Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding TextColorText, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Text Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- Pet Tab -->
                        <TabItem Header="Pet" Margin="-4,0,0,0"  Width="100">
                            <!-- Make content fill space -->
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8">
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
Text="{Binding Name, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Name" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
Text="{Binding Pronouns, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Pronouns" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <TextBlock Foreground="White" Text="   (Aa/Bb/Cc) (Default: He/Him/His)" FontFamily="Unispace" FontSize="10" Margin="8,0,0,0"/>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding PrimaryColor, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Primary Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding SecondaryColor, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Secondary Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding TertiaryColor, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Tertiary Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding DetailColor, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Detail Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Text="{Binding EyeColor, Source={StaticResource AppSettings}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" FontFamily="Unispace" FontSize="14"/>
                                    <TextBlock Foreground="White" Text="| Eye Color" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
Width="100" FontFamily="Unispace" FontSize="14">
                                        <TextBox.Text>
                                            <Binding Path="TimeInterval" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <local:IntegerValidationRule Min="1" Max="60" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Foreground="White" Text="| Time Interval" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <TextBlock Foreground="White" Text="   (01-60) (Default: 6 minutes)" FontFamily="Unispace" FontSize="10" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                    <TextBox Margin="4" Foreground="White" Background="#202020"
                         Width="100" FontFamily="Unispace" FontSize="14">
                                        <TextBox.Text>
                                            <Binding Path="SleepInterval" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <local:IntegerValidationRule Min="1" Max="60" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBlock Foreground="White" Text="| Sleep Interval" Margin="4" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <TextBlock Foreground="White" Text="   (01-60) (Default: 3 minutes)" FontFamily="Unispace" FontSize="10" Margin="8,0,0,0"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Extra" Margin="-4,0,0,0"  Width="98">
                            <!-- Make content fill space -->
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8">
                                <DockPanel>
                                    <PasswordBox x:Name="JWT"
                                 Width="100"
                                 Height="20"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="10"
                                 MaxLength="1024"
                                 PasswordChanged="JWT_Changed"/>
                                <TextBlock Foreground="White" Text="| JWT Token" Margin="8,10,0,0" FontFamily="Unispace" FontSize="16"/>
                                </DockPanel>
                                <TextBlock Foreground="White" Text="(Get your JWT from Streamelements Website)" Margin="8,2,0,0" FontFamily="Unispace" FontSize="10"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
