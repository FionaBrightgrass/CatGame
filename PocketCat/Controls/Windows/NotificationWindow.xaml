<Window x:Class="PocketCat.Controls.Windows.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PocketCat"
        Title="Notification" Height="150" Width="300" 
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" ResizeMode="NoResize" Margin="8">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UIDictionary/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" 
            BorderThickness="2" CornerRadius="5" Margin="8">
        <Grid Background="{Binding WindowColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" Opacity="0.9" Margin="0">
            <StackPanel Margin="8">
                <TextBlock x:Name="NotificationTextBlock" Text="" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           TextWrapping="Wrap" FontFamily="Unispace" FontSize="14" 
                           Foreground="{Binding TextColorText, Source={StaticResource AppSettings}}" />
                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button x:Name="ContinueButton" Content="Continue" Width="120" Height="50" Margin="5" Click="ContinueButton_Click" 
                            Style="{StaticResource FullWidthButtonStyle}" TextBlock.FontSize="14" Opacity="1"/>
                    <Button x:Name="CancelButton" Content="Cancel" Width="120" Height="50" Margin="5" Click="CancelButton_Click" 
                            Style="{StaticResource FullWidthButtonStyle}" TextBlock.FontSize="14" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
