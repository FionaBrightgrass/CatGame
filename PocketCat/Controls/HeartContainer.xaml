<UserControl x:Class="PocketCat.Controls.HeartContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PocketCat.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="32" Margin="0" Padding="0">
    <Grid>
        <Image x:Name="HeartImage"
               Width="32" Height="32"
               HorizontalAlignment="Left"
               VerticalAlignment="Top" Visibility="Visible"/>
    </Grid>
</UserControl>
