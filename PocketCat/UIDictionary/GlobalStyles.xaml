<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FullWidthButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Define the button's visual structure -->
                    <Border x:Name="ButtonBackground"
                Background="{Binding ButtonColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"
                BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"
                BorderThickness="1"
                CornerRadius="0" Margin="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Define triggers for visual states -->
                    <ControlTemplate.Triggers>
                        <!-- MouseOver state (hover) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="#202020" />
                            <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="#D0D0D0" />
                        </Trigger>

                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="#404040" />
                            <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="#FFFFFF" />
                        </Trigger>

                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBackground" Property="Background" Value="Black" />
                            <Setter TargetName="ButtonBackground" Property="BorderBrush" Value="#B0B0B0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Foreground" Value="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
        <Setter Property="FontFamily" Value="Unispace" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="BorderBrush" Value="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"/>
        <Style.Triggers>
            <!-- On mouse hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#202020" />
                <Setter Property="BorderBrush" Value="#D0D0D0" />
            </Trigger>
            <!-- On click (pressed state) -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#404040" />
                <Setter Property="BorderBrush" Value="#FFFFFF" />
            </Trigger>
            <!-- On focus -->
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="Black" />
                <Setter Property="BorderBrush" Value="#B0B0B0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FullWidthTabItemStyle" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <!-- Header Area -->
                        <Border x:Name="TabBackground"
                        Background="{Binding ButtonColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"
                        BorderBrush="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="4,4,0,0" Margin="0,4,0,0">
                            <ContentPresenter ContentSource="Header" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                    </Grid>

                    <!-- Triggers for Tab States -->
                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBackground" Property="BorderThickness" Value="2,2,2,1" />
                        </Trigger>

                        <!-- Selected State -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBackground" Property="BorderThickness" Value="2,2,2,1" />
                        </Trigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabBackground" Property="BorderThickness" Value="2,2,2,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="120"/>
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="50" />
        <Setter Property="FontFamily" Value="Unispace" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style TargetType="TabItem" x:Key="RoundedTabItemStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2" Padding="4" Margin="2">
                        <ContentPresenter 
                            ContentSource="Header" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SharpButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button" >
                    <Border Background="Transparent"
         BorderBrush="Transparent" 
         BorderThickness="0" 
         CornerRadius="0" OverridesDefaultStyle="True">
                        <!-- No rounded corners -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
        <Setter Property="FontFamily" Value="Unispace" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
        <Setter Property="Margin" Value="5"/>
    </Style>
    <Style x:Key="ShopDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Foreground" Value="{Binding TextColorBrush, Source={StaticResource AppSettings}}" />
    </Style>
    <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{Binding TextColorBrush, Source={StaticResource AppSettings}}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="ShopDataGridTextBlockStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="4"/>
        <!-- Push text down -->
        <Setter Property="FontFamily" Value="Unispace" />
        <Setter Property="FontSize" Value="16" />
        
    </Style>
    <SolidColorBrush x:Key="AppBorderBrush" Color="{Binding BorderColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
    <Color x:Key="AppBorder">#D0D0D0</Color>
    <SolidColorBrush x:Key="AppTextBrush" Color="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
    <Color x:Key="AppText">#FFFFFF</Color>
    <SolidColorBrush x:Key="AppButtonTextBrush" Color="{Binding TextColorBrush, Source={StaticResource AppSettings}, UpdateSourceTrigger=PropertyChanged}" />
    <Color x:Key="AppButtonText">#FFFFFF</Color>
    <SolidColorBrush x:Key="CatPrimaryBrush" Color="White" />
    <Color x:Key="CatPrimary">#FFFFFF</Color>
    <SolidColorBrush x:Key="CatSecondaryBrush" Color="White" />
    <Color x:Key="CatSecondary">#FFFFFF</Color>
    <SolidColorBrush x:Key="CatEyesBrush" Color="White" />
    <Color x:Key="CatEyes">#FFFFFF</Color>
</ResourceDictionary>